# Triply mobile — environment template.
# Copy to `.env.local` (gitignored) for local development:  cp .env.example .env.local
# For EAS cloud builds, set these in EAS Environment Variables (development / preview / production).
#
# EVERYTHING prefixed EXPO_PUBLIC_ IS EMBEDDED IN THE APP BINARY AND IS PUBLIC.
# Never put a Supabase secret / service-role key, database password, Resend key,
# moderation/admin secret, or SENTRY_AUTH_TOKEN in an EXPO_PUBLIC_ variable.

# Build variant: development | preview | production (EAS profiles set this automatically).
APP_VARIANT=development

# Supabase (public URL + publishable key only; access is protected by RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog (project API key is public by design). Analytics stays off unless explicitly enabled.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Sentry DSN (public by design). Required for preview and production builds.
EXPO_PUBLIC_SENTRY_DSN=

# ---- Build-time only (NOT bundled into the app) ----
# Sentry project slugs for source-map upload. Not secret.
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN must only live in your shell or as an EAS secret — never in this file.

# Optional guard: the Supabase project ref of PRODUCTION. When set, development/preview
# builds refuse to start if EXPO_PUBLIC_SUPABASE_URL points at it.
TRIPLY_PRODUCTION_SUPABASE_REF=
